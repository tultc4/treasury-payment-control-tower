      "Customer Ref",
      "Client Reference",
      "Your Reference",
      "Payment Reference",
      "E-form Number",
      "Eform Number",
      "Customer Reference Number"
    ],
    "TRANSACTION_DESCRIPTION": [
      "Transaction Description",
      "Description",
      "Narrative",
      "Transaction Details",
      "Details",
      "Particulars",
      "Remarks"
    ],
    "TRANSACTION_AMOUNT": [
      "Transaction Amount",
      "Amount",
      "Signed Amount",
      "Booking Amount",
      "Transaction Amount in Account Currency"
    ]
  }
}
